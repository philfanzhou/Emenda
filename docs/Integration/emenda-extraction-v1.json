{
  "openapi": "3.0.3",
  "info": { "title": "Emenda automatic extraction", "version": "1.0.0", "description": "Additive asynchronous extraction. Existing emenda-intake-v1 is unchanged. Trusted callers own student authorization. Originals and all result versions are retained. Model judgments do not imply teacher confirmation." },
  "security": [{ "CallerKey": [] }],
  "paths": {
    "/api/intake/extractions": {
      "post": {
        "operationId": "submitExtraction", "summary": "Bind original images and queue extraction", "description": "Required caller-scoped sourceKey binds studentId, grade and ordered original bytes/media types. Identical requests return the same job without reprocessing. Changed content returns 409 source_conflict. Repeating a Staging upload resumes original storage. Images must be single-frame JPEG/PNG, <=8192 pixels per dimension and <=16 megapixels. Duplicate image bytes are represented once. 202 confirms admission, not successful judgment or mistake creation.",
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["studentId", "grade", "sourceKey", "images"], "properties": { "studentId": { "type": "string", "minLength": 1, "maxLength": 36 }, "grade": { "type": "integer", "minimum": 1, "maximum": 12 }, "sourceKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" }, "images": { "type": "array", "minItems": 1, "maxItems": 9, "description": "Repeated images or images[] parts, JPEG/PNG, 1 byte to 15 MiB each", "items": { "type": "string", "format": "binary" } } } } } } },
        "responses": { "202": { "$ref": "#/components/responses/Job" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "415": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } }
      },
      "get": { "operationId": "listExtractions", "parameters": [{ "in": "query", "name": "studentId", "schema": { "type": "string", "maxLength": 36 } }, { "in": "query", "name": "page", "schema": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 1 } }], "responses": { "200": { "description": "At most 20 caller-owned jobs, newest first", "content": { "application/json": { "schema": { "type": "object", "required": ["success", "data"], "properties": { "success": { "type": "boolean", "enum": [true] }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/Job" } } } } } } } } }
    },
    "/api/intake/extractions/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getExtraction", "responses": { "200": { "$ref": "#/components/responses/Job" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/intake/extractions/{id}/retry": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "retryExtraction", "description": "Only Failed jobs without a completed version; maximum five total worker claims. Persisted requestKey replay does not requeue work, including after success. Accepted layout and model checkpoints are reused.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["requestKey"], "properties": { "requestKey": { "type": "string", "format": "uuid" } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Job" }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/api/intake/extractions/{id}/versions/{version}": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Version" }], "get": { "operationId": "getExtractionVersion", "responses": { "200": { "description": "Retained grouping snapshot. Item deletion is projected from current receipt state without changing history.", "content": { "application/json": { "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/Snapshot" } } } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/api/intake/extractions/{id}/sources/{sourceId}": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "in": "path", "name": "sourceId", "required": true, "schema": { "type": "string", "format": "uuid" } }], "get": { "operationId": "readExtractionOriginal", "responses": { "200": { "description": "Exact immutable original bytes, verified against retained length and SHA-256", "content": { "image/png": { "schema": { "type": "string", "format": "binary" } }, "image/jpeg": { "schema": { "type": "string", "format": "binary" } } } }, "404": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/api/intake/extractions/{id}/questions/{questionId}/images/{version}/{index}": { "parameters": [{ "$ref": "#/components/parameters/Id" }, { "$ref": "#/components/parameters/Version" }, { "in": "path", "name": "questionId", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "in": "path", "name": "index", "required": true, "schema": { "type": "integer", "minimum": 0 } }], "get": { "operationId": "readExtractionCrop", "responses": { "200": { "description": "Exact retained PNG crop, verified against length/SHA-256", "content": { "image/png": { "schema": { "type": "string", "format": "binary" } } } }, "404": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/api/intake/extractions/{id}/questions/{questionId}/review": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }, { "in": "path", "name": "questionId", "required": true, "schema": { "type": "string", "format": "uuid" } }],
      "post": {
        "operationId": "reviewExtractionQuestion",
        "description": "Trusted caller review of the exact inspected extraction version and bound mistake. The job lock serializes the version check and domain mutation with administrator revisions. Only PendingReview can become Confirmed or Rejected; stale versions and completed reviews return 409. Originals/crops must use authenticated extraction read endpoints, not the legacy image signer.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["expectedVersion", "itemId", "reviewStatus", "reviewerId"], "properties": { "expectedVersion": { "type": "integer", "minimum": 1 }, "itemId": { "type": "string", "format": "uuid" }, "reviewStatus": { "type": "integer", "enum": [2, 3] }, "reviewerId": { "type": "string", "minLength": 1, "maxLength": 36 }, "rootCause": { "type": "string", "nullable": true, "maxLength": 8000 }, "returnReason": { "type": "string", "nullable": true, "maxLength": 2000, "description": "Required and nonblank when reviewStatus is 3; retained in the review process log" } } } } } },
        "responses": { "200": { "description": "Committed review receipt using the existing lifecycle review response DTO", "content": { "application/json": { "schema": { "type": "object", "required": ["success", "data"], "properties": { "success": { "type": "boolean", "enum": [true] }, "data": { "type": "object", "required": ["success", "errorMessage", "studentId", "sourceUploadId", "removedImagePaths"], "properties": { "success": { "type": "boolean", "enum": [true] }, "errorMessage": { "type": "string" }, "studentId": { "type": "string" }, "sourceUploadId": { "type": "string" }, "removedImagePaths": { "type": "array", "items": { "type": "string" } } } } } } } } }, "400": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/admin/api/extractions/{id}/questions": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "put": { "operationId": "reviseExtraction", "security": [{ "AdminSession": [], "Csrf": [] }], "description": "Admin-only full grouping replacement. All read/upload/retry product routes are mirrored under /admin/api/extractions with the same session/CSRF boundary. New question IDs are UUIDs; existing IDs keep identity. Omitted groups are retracted without deleting history. Same requestKey and exact payload replays accepted version; conflict is 409. Actual student answer, reference and evidence are required for non-unknown outcomes. Content changes invalidate prior review/root cause and preserve historical values in a process log. Deleted item receipts are never recreated.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["requestKey", "expectedVersion", "reason", "questions"], "properties": { "requestKey": { "type": "string", "format": "uuid" }, "expectedVersion": { "type": "integer", "minimum": 0 }, "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }, "questions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/components/schemas/Question" } } } } } } }, "responses": { "200": { "$ref": "#/components/responses/Job" }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": { "CallerKey": { "type": "apiKey", "in": "header", "name": "X-Emenda-Api-Key" }, "AdminSession": { "type": "apiKey", "in": "cookie", "name": "emendaAdminSession" }, "Csrf": { "type": "apiKey", "in": "header", "name": "X-CSRF-TOKEN" } },
    "parameters": { "Id": { "in": "path", "name": "id", "required": true, "schema": { "type": "string", "format": "uuid" } }, "Version": { "in": "path", "name": "version", "required": true, "schema": { "type": "integer", "minimum": 1 } } },
    "responses": { "Job": { "description": "Durable task and result view", "content": { "application/json": { "schema": { "type": "object", "required": ["success", "data"], "properties": { "success": { "type": "boolean", "enum": [true] }, "data": { "$ref": "#/components/schemas/Job" } } } } } }, "Error": { "description": "Stable safe error code. No raw model output, credentials or internal exceptions.", "content": { "application/json": { "schema": { "type": "object", "required": ["success", "errorCode"], "properties": { "success": { "type": "boolean", "enum": [false] }, "errorCode": { "type": "string" } } } } } } },
    "schemas": {
      "Region": { "type": "object", "required": ["sourceId", "x0", "y0", "x1", "y1"], "description": "Upright displayed-image normalized frame; finite coordinates, x0<x1 and y0<y1. Not the stored EXIF frame.", "properties": { "sourceId": { "type": "string", "format": "uuid" }, "x0": { "type": "number", "minimum": 0, "maximum": 1 }, "y0": { "type": "number", "minimum": 0, "maximum": 1 }, "x1": { "type": "number", "minimum": 0, "maximum": 1 }, "y1": { "type": "number", "minimum": 0, "maximum": 1 } } },
      "Question": { "type": "object", "required": ["id", "subject", "statement", "referenceAnswer", "explanation", "outcome", "evidence", "regions"], "properties": { "id": { "type": "string", "format": "uuid" }, "questionNumber": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 64, "description": "Original printed label, including composite labels. Optional/null when absent or unreadable; never inferred from list position. No surrounding whitespace or control characters. Not unique and never used as the grouping identity." }, "subject": { "type": "integer", "minimum": 1, "maximum": 9 }, "statement": { "type": "string", "minLength": 1, "maxLength": 8000 }, "studentAnswer": { "type": "string", "nullable": true, "maxLength": 8000 }, "referenceAnswer": { "type": "string", "maxLength": 16000 }, "explanation": { "type": "string", "maxLength": 16000 }, "outcome": { "type": "string", "enum": ["correct", "incorrect", "unknown"] }, "evidence": { "type": "string", "maxLength": 16000 }, "regions": { "type": "array", "minItems": 1, "maxItems": 32, "description": "Authoritative reading order, including continuations across front/back photos. Each element produces the crop at the same zero-based images index. Upload order does not override this order.", "items": { "$ref": "#/components/schemas/Region" } } } },
      "Source": { "type": "object", "required": ["id", "path", "contentType", "length", "sha256", "width", "height"], "properties": { "id": { "type": "string", "format": "uuid" }, "path": { "type": "string" }, "contentType": { "type": "string", "enum": ["image/jpeg", "image/png"] }, "length": { "type": "integer", "format": "int64" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "width": { "type": "integer" }, "height": { "type": "integer" }, "orientation": { "type": "integer", "nullable": true, "minimum": 1, "maximum": 8 } } },
      "QuestionView": { "type": "object", "required": ["question", "itemId", "itemDeleted", "images"], "properties": { "question": { "$ref": "#/components/schemas/Question" }, "itemId": { "type": "string", "format": "uuid", "nullable": true }, "itemDeleted": { "type": "boolean" }, "images": { "type": "array", "description": "Crops in question.regions reading order. Array index is the stable zero-based part index within this version; human-facing part numbers start at 1. Retained versions preserve their own number and order.", "items": { "type": "object", "properties": { "path": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" }, "sourceId": { "type": "string", "format": "uuid" }, "region": { "$ref": "#/components/schemas/Region" }, "length": { "type": "integer", "format": "int64" }, "sha256": { "type": "string" } } } } } },
      "Snapshot": { "type": "object", "required": ["questions"], "properties": { "questions": { "type": "array", "items": { "$ref": "#/components/schemas/QuestionView" } } } },
      "Job": { "type": "object", "required": ["id", "studentId", "grade", "status", "version", "attempt", "sources", "questions", "versions"], "properties": { "id": { "type": "string", "format": "uuid" }, "studentId": { "type": "string" }, "grade": { "type": "integer" }, "status": { "type": "string", "enum": ["Staging", "Queued", "Running", "Succeeded", "Failed"] }, "version": { "type": "integer", "minimum": 0 }, "attempt": { "type": "integer", "minimum": 0, "maximum": 5 }, "errorCode": { "type": "string", "nullable": true }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }, "sources": { "type": "array", "items": { "$ref": "#/components/schemas/Source" } }, "questions": { "type": "array", "items": { "$ref": "#/components/schemas/QuestionView" } }, "versions": { "type": "array", "items": { "type": "object", "properties": { "version": { "type": "integer" }, "requestKey": { "type": "string", "format": "uuid" }, "actor": { "type": "string" }, "reason": { "type": "string" }, "model": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" } } } } } }
    }
  }
}
