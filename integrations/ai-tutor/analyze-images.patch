+test(
+  "propagates cancellation during generation without retrying",
+  { timeout: 2000 },
+  async () => {
+    let notifyStarted!: (signal: AbortSignal) => void;
+    const started = new Promise<AbortSignal>((resolve) => {
+      notifyStarted = resolve;
+    });
+    const model = new MockLanguageModelV4({
+      doGenerate: async ({ abortSignal }) => {
+        assert.ok(abortSignal);
+        notifyStarted(abortSignal);
+        return new Promise((_resolve, reject) => {
+          abortSignal.addEventListener(
+            "abort",
+            () => reject(abortSignal.reason),
+            { once: true },
+          );
+        });
+      },
+    });
+    const app = createApp({
+      model,
+      imageAnalysis: {
+        key,
+        modelId: "vision",
+        enabledModels: () => [{ id: "vision" }],
+      },
+    });
+    const controller = new AbortController();
+    const response = app.request(
+      new Request("http://localhost/api/v1/problems/analyze-images", {
+        method: "POST",
+        signal: controller.signal,
+        headers: {
+          "Content-Type": "application/json",
+          "X-Emenda-Analysis-Key": key,
+        },
+        body: JSON.stringify(request),
+      }),
+    );
+    const signal = await started;
+    controller.abort();
+    assert.equal(
+      (await (await response).json()).error.code,
+      "REQUEST_CANCELLED",
+    );
+    assert.equal(signal.aborted, true);
+    assert.equal(model.doGenerateCalls.length, 1);
+  },
+);
