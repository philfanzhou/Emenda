+++ b/apps/server/test/image-analysis.test.ts
@@ -0,0 +1,484 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { MockLanguageModelV4 } from "ai/test";
+import { createApp } from "../src/app";
+import { loadConfig } from "../src/config";
+import {
+  analysisRequestSchema,
+  parseAnalysisOutput,
+} from "../src/modules/problem/image-analysis.routes";
+const source = "11111111-1111-4111-8111-111111111111";
+const other = "22222222-2222-4222-8222-222222222222";
+const region = { sourceId: source, x0: 0, y0: 0, x1: 1, y1: 1 };
+const question = {
+  subject: 2,
+  statement: "1+1",
+  studentAnswer: null,
+  referenceAnswer: "2",
+  explanation: "",
+  outcome: "unknown",
+  evidence: "",
+  regions: [region],
+};
+const key = "k".repeat(32);
+const request = {
+  grade: 3,
+  images: [
+    {
+      sourceId: source,
+      dataUrl: "data:image/png;base64,iVBORw0KGgo=",
+      width: 100,
+      height: 100,
+      regions: [region],
+    },
+  ],
+};
+function setup(
+  output = JSON.stringify({ questions: [question] }),
+  finishReason: "stop" | "length" = "stop",
+) {
+  const model = new MockLanguageModelV4({
+    doGenerate: async () => ({
+      content: [{ type: "text", text: output }],
+      finishReason: { unified: finishReason, raw: undefined },
+      usage: {
+        inputTokens: {
+          total: 1,
+          noCache: 1,
+          cacheRead: undefined,
+          cacheWrite: undefined,
+        },
+        outputTokens: { total: 1, text: 1, reasoning: undefined },
+      },
+      warnings: [],
+    }),
+  });
+  const app = createApp({
+    model,
+    imageAnalysis: {
+      key,
+      modelId: "vision",
+      enabledModels: () => [{ id: "vision" }],
+    },
+  });
+  return { model, app };
+}
+test("revision forwards original context, preserves known IDs and rejects foreign IDs", async () => {
+  const id = "33333333-3333-4333-8333-333333333333";
+  const current = { ...question, id };
+  for (const returned of [id, "44444444-4444-4444-8444-444444444444"]) {
+    const { app } = setup(
+      JSON.stringify({ questions: [{ ...current, id: returned }] }),
+    );
+    const response = await app.request("/api/v1/problems/analyze-images", {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        "X-Emenda-Analysis-Key": key,
+      },
+      body: JSON.stringify({
+        ...request,
+        revision: {
+          instruction: "Include the continuation on the original",
+          scope: "questions",
+          questions: [current],
+        },
+      }),
+    });
+    assert.equal(response.status, returned === id ? 200 : 502);
+    if (returned === id)
+      assert.equal((await response.json()).questions[0].id, id);
+  }
+  assert.equal(
+    analysisRequestSchema.safeParse({
+      ...request,
+      revision: {
+        instruction: "Fix",
+        scope: "regions",
+        questions: [{ ...current, regions: [{ ...region, sourceId: other }] }],
+      },
+    }).success,
+    false,
+  );
+});
+test("returns 40 questions in order and rejects output-limited valid JSON", async () => {
+  const questions = Array.from({ length: 40 }, (_, i) => ({
+    ...question,
+    questionNumber: String(i + 1),
+  }));
+  for (const finishReason of ["stop", "length"] as const) {
+    const { app } = setup(
+      JSON.stringify({
+        questions: finishReason === "stop" ? questions : questions.slice(0, 32),
+      }),
+      finishReason,
+    );
+    const response = await app.request("/api/v1/problems/analyze-images", {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        "X-Emenda-Analysis-Key": key,
+      },
+      body: JSON.stringify(request),
+    });
+    assert.equal(response.status, finishReason === "stop" ? 200 : 502);
+    if (finishReason === "stop")
+      assert.deepEqual(await response.json(), { model: "vision", questions });
+  }
+});
+test("keeps front/back question label, reading order and unknown without fabricated attempt", () => {
+  const regions = [{ ...region, sourceId: other }, region];
+  const result = parseAnalysisOutput(
+    JSON.stringify({
+      questions: [{ ...question, questionNumber: "三、2（1）", regions }],
+    }),
+    new Set([source, other]),
+  );
+  assert.equal(result.length, 1);
+  assert.equal(result[0].questionNumber, "三、2（1）");
+  assert.deepEqual(result[0].regions, regions);
+  assert.equal(result[0].studentAnswer, null);
+  assert.equal(result[0].outcome, "unknown");
+});
+test("accepts missing, null and repeated printed labels without merging questions", () => {
+  for (const questionNumber of [undefined, null, "1", "a".repeat(64)]) {
+    const result = parseAnalysisOutput(
+      JSON.stringify({
+        questions: [
+          { ...question, questionNumber },
+          { ...question, questionNumber },
+        ],
+      }),
+      new Set([source]),
+    );
+    assert.equal(result.length, 2);
+    assert.equal(result[0].questionNumber, questionNumber);
+    assert.equal(result[1].questionNumber, questionNumber);
+  }
+});
+test("rejects invalid printed labels rather than trimming or repairing them", () => {
+  for (const questionNumber of [
+    "",
+    " ",
+    " 1",
+    "1 ",
+    "1\n",
+    "1\u0000",
+    "1\u0085",
+    "a".repeat(65),
+    1,
+    {},
+    [],
+  ])
+    assert.throws(() =>
+      parseAnalysisOutput(
+        JSON.stringify({ questions: [{ ...question, questionNumber }] }),
+        new Set([source]),
+      ),
+    );
+});
+test("rejects malformed outputs, foreign sources and unsupported confident judgments", () => {
+  for (const output of [
+    "not JSON",
+    JSON.stringify({ questions: [{ ...question, subject: 10 }] }),
