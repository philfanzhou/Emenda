{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://ruoyu-loki:3100",
          "labels": [
            {
              "key": "service",
              "value": "Emenda"
            }
          ]
        }
      }
    ]
  },
  "Loki": {
    "Uri": "http://localhost:3100"
  },
  "AllowedHosts": "*",
  "Database": {
    "Name": "ruoyu_study_mistake"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ruoyu_study_mistake;Username=phil",
    "MistakeLocal": ""
  },
  "Consul": {
    "Host": "host.docker.internal",
    "Port": 8500,
    "ServiceName": "Emenda",
    "KvPrefix": "config/ruoyu",
    "TimeoutMs": 3000,
    "RetryCount": 3,
    "EnableCache": true,
    "CacheDirectory": "./data/consul"
  },
  "Oss": {
    "InternalEndpoint": "localhost:8333",
    "InternalSecure": false,
    "AccessKey": "mock_access_key",
    "SecretKey": "mock_secret_key",
    "BucketName": "ruoyu-study",
    "PublicBaseUrl": "https://ry.zhoufan.asia/oss"
  },
  "StudentService": {
    "Url": "http://localhost:5005"
  },
  "VlAnalyzer": {
    "ApiKey": "",
    "BaseUrl": "https://api.siliconflow.cn/v1",
    "Model": "Qwen/Qwen3-VL-30B-A3B-Instruct",
    "Temperature": 0.1,
    "TimeoutSeconds": 60,
    "MaxRetries": 2,
    "RetryDelayMs": 1000
  }
}
