{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Name": "ruoyu_study_mistake"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ruoyu_study_mistake;Username=phil"
  },
